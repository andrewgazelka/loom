package loom:host;

interface abilities {
  perform: func(desc: list<u8>) -> result<list<u8>, string>;
}

world handler {
  import abilities;
  export run: func(state: list<u8>, msg: list<u8>) -> result<list<u8>, string>;
  export fold: func(state: list<u8>, event: list<u8>) -> list<u8>;
  export call: func(def: list<u8>, args: list<u8>) -> result<list<u8>, string>;
}
