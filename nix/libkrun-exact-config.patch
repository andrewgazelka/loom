diff --git a/init/config_test.c b/init/config_test.c
new file mode 100644
index 0000000..a8a0c5e
--- /dev/null
+++ b/init/config_test.c
@@ -0,0 +1,48 @@
+#define _GNU_SOURCE
+#define main libkrun_original_main
+#include "init.c"
+#undef main
+#include <assert.h>
+
+int main(void) {
+    char control[] = "\\u0001Z";
+    unescape_string(control, strlen(control));
+    assert(control[0] == 1 && control[1] == 'Z' && control[2] == 0);
+    char unicode[] = "\\u96ea\\ud83d\\ude00 caf\\u00e9";
+    unescape_string(unicode, strlen(unicode));
+    assert(strcmp(unicode, "雪😀 café") == 0);
+    char escapes[] = "\\\"quoted\\\"\\n\\tback\\\\slash";
+    unescape_string(escapes, strlen(escapes));
+    assert(strcmp(escapes,"\"quoted\"\n\tback\\slash") == 0);
+    char filename[] = "/tmp/loom-krun-config-test-XXXXXX";
+    int fd = mkstemp(filename); assert(fd >= 0);
+    FILE *file = fdopen(fd,"w"); assert(file);
+    fputs("{\"Cmd\":[\"/命令\",\"WorkingDir\",\"Env\",\"Cwd\",\"\",\"雪😀\\n\\u0001Z\"],\"WorkingDir\":\"/目录\",\"Env\":[\"KRUN_INIT=/arbitrary\",\"X=雪😀 café\\n\\u0001Z\"]}",file);
+    assert(fclose(file) == 0);
+    char **args=NULL, **env=NULL, *cwd=NULL;
+    unsetenv("KRUN_INIT");
+    assert(config_parse_file(&args,&cwd,&env,filename) == 0);
+    assert(strcmp(args[0],"/命令") == 0);
+    assert(strcmp(args[1],"WorkingDir") == 0);
+    assert(strcmp(args[2],"Env") == 0);
+    assert(strcmp(args[3],"Cwd") == 0);
+    assert(strcmp(args[4],"") == 0);
+    assert(strcmp(args[5],"雪😀\n\1Z") == 0);
+    assert(args[6] == NULL);
+    assert(strcmp(cwd,"/目录") == 0);
+    assert(strcmp(env[0],"KRUN_INIT=/arbitrary") == 0);
+    assert(strcmp(env[1],"X=雪😀 café\n\1Z") == 0);
+    assert(getenv("KRUN_INIT") == NULL);
+    setenv("LOOM_HOST_SECRET", "not-for-guest",1);
+    assert(config_apply_environment(env) == 0);
+    assert(getenv("LOOM_HOST_SECRET") == NULL);
+    assert(strcmp(getenv("KRUN_INIT"),"/arbitrary") == 0);
+    assert(strcmp(getenv("X"),"雪😀 café\n\1Z") == 0);
+    for(size_t i=0;args[i];i++) free(args[i]);
+    free(args);free(cwd);
+    for(size_t i=0;env[i];i++) free(env[i]);
+    free(env);
+    unlink(filename);
+    puts("5/5 libkrun config controls pass");
+    return 0;
+}
